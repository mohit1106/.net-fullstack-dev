@model WebApplication1.Models.StudentPagedResult

<h2>Students</h2>

<table border="1">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Age</th>
        <th>City</th>
    </tr>
    @foreach (var student in Model.Students)
    {
        <tr>
            <td>@student.Id</td>
            <td>@student.Name</td>
            <td>@student.Age</td>
            <td>@student.City</td>
        </tr>
    }
</table>

<br />
<p>Page @Model.PageNumber of @Model.TotalPages</p>

@if (Model.HasNextPage)
{
    <a href="/Students?page=@(Model.PageNumber + 1)">Next</a>
}
    </nav>
</div>
