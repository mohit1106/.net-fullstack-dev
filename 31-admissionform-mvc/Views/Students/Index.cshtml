@model IEnumerable<_31_admissionform_mvc.Models.Student>

@{
    ViewData["Title"] = "Students - Admission Management";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="page-title">Students Management</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary btn-lg">
                <i class="icon">➕</i> Add New Student
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover custom-table">
                <thead class="table-header">
                    <tr>
                        <th scope="col">First Name</th>
                        <th scope="col">Last Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Phone</th>
                        <th scope="col">Course</th>
                        <th scope="col">Admission Date</th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.FirstName</td>
                            <td>@student.LastName</td>
                            <td>@student.Email</td>
                            <td>@student.Phone</td>
                            <td>
                                <span class="badge bg-info text-dark">@student.Course</span>
                            </td>
                            <td>@student.AdmissionDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@student.StudentId" 
                                   class="btn btn-sm btn-info" title="View Details">
                                    👁️
                                </a>
                                <a asp-action="Edit" asp-route-id="@student.StudentId" 
                                   class="btn btn-sm btn-warning" title="Edit">
                                    ✏️
                                </a>
                                <a asp-action="Delete" asp-route-id="@student.StudentId" 
                                   class="btn btn-sm btn-danger" title="Delete">
                                    🗑️
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <h4>No students found</h4>
            <p>Click "Add New Student" to create your first admission record.</p>
        </div>
    }
</div>
