@model _31_admissionform_mvc.Models.Student

@{
    ViewData["Title"] = "Create Student - Admission Form";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="form-card">
                <h1 class="page-title">New Student Admission</h1>
                
                <form asp-action="Create" method="post" novalidate="novalidate" class="needs-validation">
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">First Name <span class="required">*</span></label>
                            <input asp-for="FirstName" type="text" class="form-control" placeholder="John" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">Last Name <span class="required">*</span></label>
                            <input asp-for="LastName" type="text" class="form-control" placeholder="Doe" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email <span class="required">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="john.doe@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone (10 digits) <span class="required">*</span></label>
                            <input asp-for="Phone" type="tel" class="form-control" placeholder="9876543210" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label">Date of Birth (Age ≥ 15) <span class="required">*</span></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label">Gender <span class="required">*</span></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Select Gender --</option>
                                @foreach (var gender in (List<string>)ViewData["Genders"])
                                {
                                    <option value="@gender">@gender</option>
                                }
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Course" class="form-label">Course <span class="required">*</span></label>
                        <select asp-for="Course" class="form-select">
                            <option value="">-- Select Course --</option>
                            @foreach (var course in (List<string>)ViewData["Courses"])
                            {
                                <option value="@course">@course</option>
                            }
                        </select>
                        <span asp-validation-for="Course" class="text-danger small"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="icon">💾</i> Create Student
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-lg">
                            <i class="icon">❌</i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
